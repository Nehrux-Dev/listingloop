# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# `.env` is git-ignored and is read by both docker compose and Django.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# Generate a new one for anything that is not local dev:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Must be at least 32 bytes — it is also the HS256 JWT signing key.
DJANGO_SECRET_KEY=dev-insecure-key-replace-me-before-any-real-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_TIME_ZONE=UTC

# Comma-separated origins allowed to call the API from a browser (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication (JWT) --------------------------------------------------
# Access tokens are held in browser memory and cannot be revoked once issued,
# so keep the lifetime short.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=5
# Refresh tokens only ever travel in an httpOnly cookie. Rotated and
# blacklisted on every use.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Rate limit for login / register / refresh, per client IP.
AUTH_THROTTLE_RATE=30/min
# Rate limit for the listing URL import, which makes the server fetch a
# user-supplied URL. Keep this low.
LISTING_IMPORT_THROTTLE_RATE=10/min
PASSWORD_MIN_LENGTH=10

# --- Refresh-token cookie --------------------------------------------------
# See backend/apps/accounts/cookies.py for what each flag defends against.
AUTH_COOKIE_NAME=refresh_token
# MUST be True in production (HTTPS only). Defaults to `not DEBUG`; leave it
# blank/False only for local http://localhost development.
AUTH_COOKIE_SECURE=False
# CSRF defence. 'Lax' works when the SPA and API share a site (the Vite proxy
# setup below). 'None' requires Secure=True and needs an added CSRF token.
AUTH_COOKIE_SAMESITE=Lax
# Scopes the cookie so it is only ever sent to the auth endpoints.
AUTH_COOKIE_PATH=/api/auth/
# Leave empty for a host-only cookie (safest).
AUTH_COOKIE_DOMAIN=

# --- OpenAI ----------------------------------------------------------------
# Read by the backend ONLY. It is never sent to the browser, never appears in
# an API response, and the frontend never calls OpenAI directly. Leave blank to
# disable generation (the API then fails cleanly rather than silently).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# Override published prices (USD per million tokens) without a code change:
#   OPENAI_PRICING_OVERRIDES=gpt-4o-mini:0.15:0.60,gpt-4o:2.50:10.00
OPENAI_PRICING_OVERRIDES=
# Generation costs money at the provider, so this ceiling is per user, per hour.
AI_GENERATE_THROTTLE_RATE=20/hour

# --- Rendering service -----------------------------------------------------
# Chromium runs in its own container. It renders arbitrary HTML, so it is not
# published to the host — only the backend reaches it, over the compose
# network, with this shared token. Change it for anything real.
RENDERER_URL=http://renderer:8080
RENDERER_TOKEN=dev-renderer-token-change-me
RENDERER_TIMEOUT_SECONDS=30
# Device pixel ratio for exports (1 already yields 1080px-wide social images).
RENDERER_SCALE=1
RENDERER_JPG_QUALITY=90
# Concurrent browser pages per output size. Chromium's memory grows with live
# pages, so raise this only alongside RENDERER_MEM_LIMIT.
RENDERER_PAGES_PER_VIEWPORT=2
RENDERER_MEM_LIMIT=1500m
RENDER_THROTTLE_RATE=60/min

# --- File storage / uploads ------------------------------------------------
# Uploads go through Django's storage API, so switching backends is a settings
# change only. See backend/apps/core/storage.py.
MEDIA_URL=/media/
# Defaults to backend/media. Point this at a mounted volume on a VPS.
# MEDIA_ROOT=/var/lib/real-estate/media
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
# For an S3-compatible bucket later:
#   pip install "django-storages[s3]"
#   DEFAULT_FILE_STORAGE=storages.backends.s3.S3Storage
# Enforced on every write path regardless of backend.
MAX_IMAGE_UPLOAD_MB=5

# --- PostgreSQL ------------------------------------------------------------
# These three are consumed by the `db` container to initialise the cluster.
POSTGRES_DB=real_estate
POSTGRES_USER=real_estate
POSTGRES_PASSWORD=real_estate
# Host is the compose service name from inside containers; use localhost when
# running Django directly on your machine.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port published on the host machine (change if 5432 is already taken).
POSTGRES_HOST_PORT=5432

# Full URL wins over the discrete settings above when present.
DATABASE_URL=postgres://real_estate:real_estate@db:5432/real_estate

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Ports published on the host ------------------------------------------
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Frontend (Vite only exposes variables prefixed with VITE_) -------------
# Leave empty to use same-origin requests (/api/...) through the Vite dev
# proxy. Set an absolute URL only if you want the browser to call Django
# directly, in which case that origin must be in CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api to. Compose service name inside
# Docker; use http://localhost:8000 when running `npm run dev` on your machine.
VITE_API_PROXY_TARGET=http://backend:8000
