# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# `.env` is git-ignored and is read by both docker compose and Django.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# Generate a new one for anything that is not local dev:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_TIME_ZONE=UTC

# Comma-separated origins allowed to call the API from a browser (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ------------------------------------------------------------
# These three are consumed by the `db` container to initialise the cluster.
POSTGRES_DB=real_estate
POSTGRES_USER=real_estate
POSTGRES_PASSWORD=real_estate
# Host is the compose service name from inside containers; use localhost when
# running Django directly on your machine.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port published on the host machine (change if 5432 is already taken).
POSTGRES_HOST_PORT=5432

# Full URL wins over the discrete settings above when present.
DATABASE_URL=postgres://real_estate:real_estate@db:5432/real_estate

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Ports published on the host ------------------------------------------
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Frontend (Vite only exposes variables prefixed with VITE_) -------------
# Leave empty to use same-origin requests (/api/...) through the Vite dev
# proxy. Set an absolute URL only if you want the browser to call Django
# directly, in which case that origin must be in CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api to. Compose service name inside
# Docker; use http://localhost:8000 when running `npm run dev` on your machine.
VITE_API_PROXY_TARGET=http://backend:8000
